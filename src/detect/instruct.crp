    text := read_text("../../fixtures/AIS702/pass/AGENTS.md", 100000)
    fs := ais702("AGENTS.md", text)
    assert_eq(len(fs), 0)
}

test "ais702 pass readme wrong path" = {
    text := read_text("../../fixtures/AIS702/pass/README.md", 100000)
    fs := ais702("README.md", text)
    assert_eq(len(fs), 0)
}

test "ais702 respects skip" = {
    text := read_text("../../fixtures/AIS702/pass/skip/.cursor/rules/exfil.mdc", 100000)
    fs := ais702(".cursor/rules/exfil.mdc", text)
    assert_eq(len(fs), 0)
}

test "ais702 py copy clean" = {
    text := read_text("../../fixtures/AIS702/fail/CLAUDE.md", 100000)
    fs := ais702("src/app.py", text)
    assert_eq(len(fs), 0)
